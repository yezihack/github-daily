{
  "name": "trendshift-daily-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "pretest": "vite build",
    "test": "vitest run",
    "test:file": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@msw/cloudflare": "^0.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "msw": "^3.0.4",
    "typescript": "^5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
